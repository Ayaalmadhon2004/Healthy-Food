generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HealthTip {
  id          Int    @id @default(autoincrement())
  header      String
  iconName    String
  advice      String
  details     String
  moreDetails String
}

model FoodRecipe {
  id           Int      @id @default(autoincrement())
  img          String
  type         String
  title        String
  time         String
  cal          String
  nutrition    Json     // Stores {protein, carbs, etc.}
  ingredients  String[] // Array of strings
  instructions String[] // Array of strings
}
