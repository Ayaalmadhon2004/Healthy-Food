generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HealthTip {
  id          Int    @id @default(autoincrement())
  header      String
  iconName    String
  advice      String
  details     String
  moreDetails String
}

model FoodRecipe {
  id           Int      @id @default(autoincrement())
  img          String
  type         String
  title        String
  time         String
  cal          String
  nutrition    Json     // Stores {protein, carbs, etc.}
  ingredients  String[] // Array of strings
  instructions String[] // Array of strings
}

model Kitchen {
  id                Int      @id @default(autoincrement())
  name              String
  location          String
  region            String
  distribution_time String
  capacity          String
  todays_meal       String
  access_info       String
  contact           String
  createdAt         DateTime @default(now())
}

model Doctor {
  id             Int      @id @default(autoincrement())
  name           String
  specialty      String
  qualifications String[] // Native array support in Postgres
  rating         Float
  reviews        Int
  location       String
  phone          String
  email          String
  about          String   @db.Text
  image          String   @db.Text // Use Text for long base64 strings
  availability   String
}
