generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HealthTip {
  id          Int      @id @default(autoincrement())
  header      Json
  iconName    String
  advice      Json
  details     Json
  moreDetails Json
  createdAt   DateTime @default(now())
}

model FoodRecipe {
  id           Int      @id @default(autoincrement())
  img          String
  type         Json
  title        Json
  time         Json
  cal          Json
  nutrition    Json
  ingredients  Json
  instructions Json
  createdAt    DateTime @default(now())
}

model Kitchen {
  id               Int      @id @default(autoincrement())
  name             Json
  location         Json
  region           Json
  distributionTime Json
  capacity         Json
  todaysMeal       Json
  accessInfo       Json
  contact          String
  createdAt        DateTime @default(now())
}

model Doctor {
  id             Int      @id @default(autoincrement())
  name           Json
  specialty      Json
  about          Json
  qualifications Json       // بدل String[]
  rating         Float
  reviews        Int
  location       Json      // إذا تحب تدعم en/ar
  phone          String
  email          String
  image          String   @db.Text
  availability   Json      // بدل String لو en/ar
}

model NutritionGuide {
  id        Int      @id @default(autoincrement())
  content   Json     
  updatedAt DateTime @updatedAt
}


