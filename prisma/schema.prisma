generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HealthTip {
  id          Int    @id @default(autoincrement())
  header      String
  iconName    String
  advice      String
  details     String
  moreDetails String
}

model FoodRecipe {
  id           Int      @id @default(autoincrement())
  img          String
  type         String
  title        String
  time         String
  cal          String
  nutrition    Json     // Stores {protein, carbs, etc.}
  ingredients  String[] // Array of strings
  instructions String[] // Array of strings
}

model Kitchen {
  id                Int      @id @default(autoincrement())
  name              String
  location          String
  region            String
  distribution_time String
  capacity          String
  todays_meal       String
  access_info       String
  contact           String
  createdAt         DateTime @default(now())
}

model Doctor {
  id             Int      @id @default(autoincrement())
  name           Json
  specialty      Json
  about          Json
  qualifications Json       // بدل String[]
  rating         Float
  reviews        Int
  location       Json      // إذا تحب تدعم en/ar
  phone          String
  email          String
  image          String   @db.Text
  availability   Json      // بدل String لو en/ar
}


