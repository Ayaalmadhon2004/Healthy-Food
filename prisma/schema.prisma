datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


enum Role {
  USER
  ORG
  ADMIN
  DOCTOR
}

model User {
  id                  String          @id
  name                String
  email               String          @unique
  phone               String?
  role                Role            @default(USER)
  neighborhood        String?
  landmark            String?
  addressDetails      String?
  dietary_preferences Json?           @default("[]")
  health_goals        Json?           @default("[]")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // العلاقات (Relationships)
  meals     Meal[]
  favorites Favorite[]
  orders    MealOrder[]
  tickets   SupportTicket[]
  areaReports   AreaReport[]
  appointments  Appointment[]
  doctorProfile Doctor?
  notifications Notification[]
}

model HealthTip {
  id          Int      @id @default(autoincrement())
  header      Json
  iconName    String
  advice      Json
  details     Json
  moreDetails Json
  createdAt   DateTime @default(now())
}

model FoodRecipe {
  id           Int        @id @default(autoincrement())
  img          String
  type         Json
  title        Json
  time         Json
  cal          Json
  nutrition    Json
  ingredients  Json
  instructions Json
  createdAt    DateTime   @default(now())
  favorites    Favorite[]
}

model Kitchen {
  id               Int         @id @default(autoincrement())
  name             Json
  location         Json
  region           Json
  distributionTime Json
  capacity         Json
  todaysMeal       Json
  accessInfo       Json
  contact          String
  createdAt        DateTime    @default(now())
  orders           MealOrder[]
}

model Doctor {
  id             Int      @id @default(autoincrement())
  name           Json
  specialty      Json
  about          Json
  qualifications Json
  rating         Float
  reviews        Int
  location       Json
  phone          String
  email          String
  image          String   @db.Text
  availability   Json
  // The account that manages this profile (set by an admin, role DOCTOR).
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
}

// A patient's request for a visit on a given day; the doctor confirms and completes it.
model Appointment {
  id            Int      @id @default(autoincrement())
  doctorId      Int
  patientId     String
  preferredDate DateTime // calendar day at 00:00 UTC
  note          String?
  status        String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  createdAt     DateTime @default(now())
  doctor        Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       User     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId, preferredDate])
  @@index([doctorId, preferredDate])
  @@map("appointments")
}

model NutritionGuide {
  id        Int      @id @default(autoincrement())
  content   Json
  updatedAt DateTime @updatedAt
}

model Meal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealType  String
  foodName  String
  calories  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("meals")
}

model Favorite {
  id         String     @id @default(uuid())
  userId     String
  recipeId   Int
  recipeData Json?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe     FoodRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model MealOrder {
  id         Int      @id @default(autoincrement())
  userId     String
  kitchenId  Int
  quantity   Int      @default(1)
  status     String   @default("PENDING")
  orderDate  DateTime @default(now())
  targetDate DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitchen    Kitchen  @relation(fields: [kitchenId], references: [id], onDelete: Cascade)

  @@unique([userId, kitchenId, targetDate])
  @@map("meal_orders")
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("support_tickets")
}

model AreaReport {
  id          Int      @id @default(autoincrement())
  userId      String   
  areaName    String   
  description String   
  status      String   @default("pending") // pending, seen, investigated
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

// Durable fixed-window rate limiter state (see lib/rateLimit.ts)
model RateLimit {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  windowStart DateTime
  count       Int

  @@index([windowStart])
  @@map("rate_limits")
}

// Something the user should hear about; today, a doctor changing the status of their appointment.
// The doctor name and day are copied in so the message still reads right if the appointment is deleted.
model Notification {
  id            Int      @id @default(autoincrement())
  userId        String
  appointmentId Int?
  status        String
  doctorName    Json
  visitDate     DateTime
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}
