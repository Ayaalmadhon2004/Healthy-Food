generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ORG
  ADMIN
}

model User {
  id                   String   @id
  name                 String
  email                String   @unique
  phone                String?
  role                 Role     @default(USER)
  dietary_preferences  Json?    @default("[]")
  health_goals         Json?    @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  meals                Meal[]   
  favorites            Favorite[] 
}

model HealthTip {
  id          Int      @id @default(autoincrement())
  header      Json
  iconName    String
  advice      Json
  details     Json
  moreDetails Json
  createdAt   DateTime @default(now())
}

model FoodRecipe {
  id           Int      @id @default(autoincrement())
  img          String
  type         Json
  title        Json
  time         Json
  cal          Json
  nutrition    Json
  ingredients  Json
  instructions Json
  createdAt    DateTime @default(now())
}

model Kitchen {
  id               Int      @id @default(autoincrement())
  name             Json
  location         Json
  region           Json
  distributionTime Json
  capacity         Json
  todaysMeal       Json
  accessInfo       Json
  contact          String
  createdAt        DateTime @default(now())
}

model Doctor {
  id             Int      @id @default(autoincrement())
  name           Json
  specialty      Json
  about          Json
  qualifications Json      
  rating         Float
  reviews        Int
  location       Json     
  phone          String
  email          String
  image          String   @db.Text
  availability   Json      
}

model NutritionGuide {
  id        Int      @id @default(autoincrement())
  content   Json     
  updatedAt DateTime @updatedAt
}

model Meal {
  id         String   @id @default(uuid())
  userId     String   
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  mealType   String   
  foodName   String
  calories   Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("meals") 
}

model FoodLog {
  id          String   @id @default(cuid())
  userId      String   
  mealName    String   
  calories    Int      
  mealType    String   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String  
  recipeId  String   
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, recipeId]) 
}