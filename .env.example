# PostgreSQL (Supabase pooled connection for the app, direct connection for migrations)
DATABASE_URL=postgresql://user:password@host:5432/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only: used by sign-up to create users. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for /api/cron/keep-alive (sent as "Authorization: Bearer <secret>").
# Required in production, otherwise the endpoint returns 401.
CRON_SECRET=change-me

# Public origin of the site (no trailing slash). Used for canonical URLs, Open Graph tags,
# sitemap.xml and robots.txt. On Vercel the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Nutrition assistant (free by default) ---
# With nothing below set, answers are assembled from the knowledge base itself: no model, no key, no cost.
# For smoother wording add a FREE Google AI Studio key (the free tier has rate limits); it is picked up automatically.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Force a provider: extractive | gemini | anthropic. anthropic is paid and is never chosen unless set here.
# LLM_PROVIDER=extractive
# ANTHROPIC_API_KEY=
# Retrieval: memory (default, needs no model) or pgvector (database-side search with a local embedding model).
# RAG_RETRIEVER=memory
# Only used with RAG_RETRIEVER=pgvector: where the ~100 MB embedding model is cached, and a switch to skip it.
# RAG_MODEL_CACHE_DIR=
# RAG_DISABLE_EMBEDDINGS=1
